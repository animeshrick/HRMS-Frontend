# Used only by "npm run build:hostinger". Nothing secret belongs here.
#
# Hostinger serves plain files, so there is no /api proxy as on Cloudflare or in development.
# The browser calls the AWS backend (13.205.158.186) directly, and because the site is HTTPS
# the API address must be HTTPS too: a subdomain pointing at the instance, with a certificate.
# The backend must also allow this site as a CORS origin.
VITE_API_BASE_URL=https://hrms.silvamethod.in
VITE_DOWNTIME=false
