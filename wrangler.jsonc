{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrms-frontend",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Where /api/* is forwarded. Change it here if the backend moves.
  "vars": { "BACKEND_ORIGIN": "https://internal-docs-rag.onrender.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/login, /chat, ...) must return index.html, not a 404.
    "not_found_handling": "single-page-application",
    // Without this, the line above also swallows /api/* and returns index.html,
    // so the Worker never runs. This makes /api/* hit the Worker first.
    "run_worker_first": ["/api/*"]
  }
}
