{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrms-frontend",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Where /api/* is forwarded in production. Change it here if the backend moves.
  // The backend is the AWS EC2 instance (13.205.158.186), served over HTTPS at hrms.silvamethod.in.
  // A Worker cannot fetch a raw IP (error 1003), so it needs this hostname.
  // Previous backend (Render): https://internal-docs-rag.onrender.com
  "vars": { "BACKEND_ORIGIN": "https://hrms.silvamethod.in" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/login, /chat, ...) must return index.html, not a 404.
    "not_found_handling": "single-page-application",
    // Without this, the line above also swallows /api/* and returns index.html,
    // so the Worker never runs. This makes /api/* hit the Worker first.
    "run_worker_first": ["/api/*"]
  }
}
