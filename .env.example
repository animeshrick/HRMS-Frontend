# Copy this file to .env.local when you need to change a value. Never put secrets in a frontend file:
# everything here is visible to anyone who opens the website.

# Where the browser sends API calls.
#   "/api"  (default)  works with the Vite dev proxy below, and with a reverse proxy in production.
#   "https://hr-api.example.com"  calls the backend directly (the backend then needs CORS for this site).
# VITE_API_BASE_URL=/api

# Development only: where the FastAPI server runs.
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
